# pnpm db:test:setup cria .env.test local com senha e chave JWT aleatórias.
# O banco de teste tem usuário próprio e nunca usa helpdesk-db.
NODE_ENV=test
DATABASE_URL=postgresql://helpdesk_test:configure_com_db_test_setup@localhost:5432/helpdesk_test?schema=public
JWT_SECRET=configure_uma_chave_aleatoria_de_pelo_menos_32_bytes
JWT_ISSUER=helpdesk-test
JWT_AUDIENCE=helpdesk-test-client
CORS_ORIGINS=http://localhost:5173
AUTH_COOKIE_SAME_SITE=lax
TEST_POSTGRES_CONTAINER=postgres-helpdesk
